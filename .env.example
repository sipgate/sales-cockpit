# HubSpot authentication
# The app uses a HubSpot Private App Token issued from the sipgate 2025
# HubSpot (Account ID 27058496). Only admins in that hub can create one —
# see AGENTS.md → "HubSpot authentication" for the exact procedure and
# which scopes the token needs.
# Format: pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HUBSPOT_PRIVATE_APP_TOKEN="pat-eu1-your-private-app-token"

# JIRA (read-only, Atlassian Cloud). Create the API token at
# https://id.atlassian.com/manage-profile/security/api-tokens — use the
# left button "Create API token", NOT the scoped variant (see AGENTS.md →
# "JIRA authentication").
JIRA_BASE_URL="https://sipgatede.atlassian.net"
JIRA_EMAIL="mellor@sipgate.de"
JIRA_API_TOKEN="your-jira-api-token"

# Amplitude via BigQuery REST API: service-account key as JSON (either the
# full JSON inline here, or a file path in GOOGLE_APPLICATION_CREDENTIALS).
GOOGLE_APPLICATION_CREDENTIALS_JSON="{ ...service account key json... }"

# MCP server (GET/POST /api/mcp). Bearer token clients must send as
# `Authorization: Bearer <MCP_SECRET>`. Required — the endpoint returns 503
# until it is set. Generate with: openssl rand -hex 32
MCP_SECRET="your-mcp-secret-generate-with-openssl-rand-hex-32"

# ── Optional tuning (defaults in parentheses) ─────────────────────────────
# Poll-Takte des Runtime-Pollers (Millisekunden):
# POLL_HUBSPOT_MS (900000 = 15 min) — pipelines, deals, enrichment, leads
# POLL_PROJECTS_MS (3600000 = 60 min) — projects (HubSpot + JIRA)
# POLL_BQ_MS (21600000 = 6 h) — marketing funnel + playbook (BigQuery)
# Kostendeckel je BigQuery-Query, Bytes (322122547200 = 300 GiB):
# BIGQUERY_MAX_BYTES_BILLED=322122547200
# Persistenz-Verzeichnis des Runtime-Stores (os.tmpdir()/sales-cockpit-store):
# SALES_COCKPIT_STORE_DIR="/tmp/sales-cockpit-store"

# ── Nur in der Nautilus-Config (.sipgate/nautilus.yaml), nicht hier ───────
# Die Secrets oben werden im Cluster via nautilusctl versiegelt. Egress
# geht über den undici-EnvHttpProxyAgent (HTTP_PROXY/HTTPS_PROXY/NO_PROXY
# aus der Cluster-Umgebung).
